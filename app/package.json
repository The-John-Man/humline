{
  "name": "humline",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:browser": "playwright test",
    "format": "prettier --write src server tests scripts *.ts *.json index.html",
    "format:check": "prettier --check src server tests scripts *.ts *.json index.html",
    "test:https": "node scripts/verify-https.mjs",
    "dev:full": "concurrently -k \"npm:dev\" \"npm:dev:api\"",
    "dev:api": "tsx watch --env-file-if-exists=.env server/index.ts",
    "start": "tsx --env-file-if-exists=.env server/index.ts",
    "db:migrate": "tsx --env-file-if-exists=.env server/index.ts --migrate",
    "test:clerk": "node --env-file-if-exists=.env node_modules/@playwright/test/cli.js test -c playwright.clerk.config.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.26.2",
    "@clerk/react": "^6.18.1",
    "@tonejs/midi": "^2.0.28",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "lucide-react": "^1.61.0",
    "pg": "^8.23.1",
    "pitchy": "^4.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@clerk/testing": "^2.2.50",
    "@playwright/test": "^1.64.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "jsdom": "^30.1.3",
    "pg-mem": "^3.0.14",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
