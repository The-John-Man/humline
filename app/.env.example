# Copy to .env (ignored by Git). Never put backend secrets under a VITE_ name.
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=
DATABASE_URL=postgresql://humline:local-development-only@localhost:5432/humline
# Optional disposable DB for API tests (name must end with _test; tables are cleared).
# TEST_DATABASE_URL=postgresql://humline:local-development-only@localhost:5432/humline_test
# Optional emails for npm run test:clerk (development instance test users).
# CLERK_TEST_USER_A=
# CLERK_TEST_USER_B=
APP_ORIGINS=http://localhost:5173,http://localhost:3001,http://127.0.0.1:5173,http://127.0.0.1:3001
PORT=3001
